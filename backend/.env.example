# Puerto de red del servidor NestJS
PORT=3000

# Entorno de ejecución (development | production)
NODE_ENV=production

# Rutas de persistencia física para las bases de datos SQLite independientes
DATABASE_PORTFOLIO_PATH=./data/portfolio.sqlite
DATABASE_KARTEX_PATH=./data/kartex.sqlite
DATABASE_DOICELADEV_PATH=./data/doiceladev.sqlite

# Orígenes de CORS permitidos en producción (separados por comas)
CORS_ORIGINS=https://jorgedoicela.com,https://portfolio.jorgedoicela.com,https://kartex.jorgedoicela.com,https://doiceladev.jorgedoicela.com

# Clave oficial de API.Bible (American Bible Society / Digital Bible Library)
API_BIBLE_KEY=

# Clave oficial de YouVersion Platform
YVP_APP_KEY=

# Bot de Telegram para notificaciones instantáneas del formulario de contacto
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# AMAZON SES (Simple Email Service - Newsletter y Boletines de DoicelaDev)
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_FROM_EMAIL=newsletter@doiceladev.jorgedoicela.com
SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USER=
SES_SMTP_PASS=
DOICELADEV_PUBLIC_URL=https://doiceladev.jorgedoicela.com

# ------------------------------------------------------------------------------
# PORTFOLIO SANDBOX (Terminal Linux Real en Docker)
# ------------------------------------------------------------------------------
# Modo de ejecución del Sandbox:
#   - 'vps'    : Ejecución local en el VPS de AWS Lightsail (64MB cgroups, máx 3 sesiones)
#   - 'tunnel' : Ejecución delegada a PC Casera vía Cloudflare Tunnel (más CPU/RAM)
SANDBOX_MODE=vps

# Concurrencia máxima de contenedores simultáneos (protección 1 GB RAM)
SANDBOX_MAX_SESSIONS=3

# Ruta al Docker Socket (opcional, defaults según plataforma)
# Linux: /var/run/docker.sock
# Windows: //./pipe/docker_engine
# DOCKER_SOCKET_PATH=/var/run/docker.sock

